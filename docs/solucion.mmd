%% Diagrama de la solución. Render: make diagram  →  docs/solucion.png
%% Todo lo que aparece está desplegado. Sin CloudFront (D-31) ni Glue/Athena (D-37): el Learner Lab no los permite.
flowchart LR
    classDef deployed fill:#d3f9d8,stroke:#2b8a3e,stroke-width:2px,color:#0b3d17
    classDef group fill:#ffffff,stroke:#adb5bd,color:#212529

    subgraph CLI["Cliente"]
        direction TB
        BR["Navegador<br/>SPA React (Carbon)"]:::deployed
    end

    subgraph EDGE["Entrada · stack foundation (siempre arriba)"]
        direction TB
        SITE[("S3 site<br/>website HTTP · build de la SPA")]:::deployed
        COG["Cognito<br/>managed login Carbon · registro con código por email"]:::deployed
        APIGW["API Gateway HTTP API<br/>HTTPS · CORS · JWT Cognito · throttling 20/s"]:::deployed
    end

    subgraph VPC["VPC · stack cluster (se destruye con make cluster-down)"]
        direction TB
        subgraph PRIV["subredes privadas"]
            LINK["VPC link"]:::deployed
            ALB["ALB interno<br/>Terraform · target group IP :3000"]:::deployed
            REDIS[("ElastiCache Valkey<br/>lock + snapshots · TLS")]:::deployed
        end
        subgraph EKS["EKS · 2× t3.medium"]
            direction TB
            subgraph NSAPP["ns app"]
                API["backend-api ×2<br/>TargetGroupBinding"]:::deployed
                WRK["backend-worker ×1"]:::deployed
            end
            subgraph NSINJ["ns injector"]
                INJ["injector ×1"]:::deployed
            end
            subgraph NSMOCK["ns mock · sistema simulado"]
                direction LR
                GW["gateway"]:::deployed --> ORD["orders ×2"]:::deployed --> WS["worker-svc"]:::deployed
            end
        end
    end

    subgraph DATA["Servicios administrados · stack foundation"]
        direction TB
        DDB[("DynamoDB<br/>Sessions + GSI Leaderboard<br/>historial, gráficas, ranking")]:::deployed
        FQ[["SQS faults + DLQ"]]:::deployed
        UQ[["SQS user-actions.fifo + DLQ"]]:::deployed
        FILES[("S3 files<br/>scenarios/ · logs/")]:::deployed
        ECR[("ECR ×3<br/>imágenes por git SHA")]:::deployed
        SFN{{"Step Functions<br/>máquina scenario · warmup, espera del fix, timeout"}}:::deployed
    end

    BR -- "HTML/JS" --> SITE
    BR -- "login / registro" --> COG
    BR -- "HTTPS /api/* + token" --> APIGW
    APIGW -. "valida JWT" .-> COG
    APIGW --> LINK --> ALB
    ALB -- "IPs de pods" --> API
    API -- "Get/Put/UpdateItem" --> DDB
    API -- "acciones del usuario" --> UQ
    API -- "GetObject escenarios" --> FILES
    API -- "lock de sesión" --> REDIS
    WRK -- "snapshots" --> REDIS
    WRK -- "logs por sesión" --> FILES
    FQ -- "long poll" --> INJ
    INJ -- "escala a 0 / borra pods" --> NSMOCK
    INJ -- "STARTING → INCIDENT_ACTIVE" --> DDB
    UQ -- "FIFO por sesión" --> WRK
    WRK -- "aplica el fix" --> NSMOCK
    ECR -. "pull de imágenes" .-> EKS

    API -- "StartExecution" --> SFN
    SFN -- "FAULT tras warmup" --> FQ
    SFN -- "AWAIT_FIX (token)" --> UQ
    SFN -- "RESOLVED / FAILED + score" --> DDB
    WRK -- "SendTaskSuccess / Failure" --> SFN

    class CLI,EDGE,VPC,PRIV,EKS,NSAPP,NSINJ,NSMOCK,DATA group
