# Written by scripts/render-config.sh (config.env is gitignored). Example values only.
# Becomes ConfigMap oncall-config in `app` and `injector` (ARCHITECTURE §5.4, §15).
AWS_REGION=us-east-1
SESSIONS_TABLE=Sessions
FILES_BUCKET=oncall-training-files-000000000000
FAULTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/oncall-training-faults
USER_ACTIONS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/oncall-training-user-actions.fifo
MOCK_NAMESPACE=mock
MOCK_HEALTH_URL_TEMPLATE=http://{service}.mock.svc.cluster.local:8080/health
MOCK_CLUSTER=kubernetes
AUTH_MODE=dev
ALLOW_DEV_AUTH=true
ORCHESTRATION_MODE=direct
STATS_MODE=athena
