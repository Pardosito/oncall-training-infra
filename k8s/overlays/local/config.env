# Injector config for kind (committed: LocalStack values only, no real credentials).
# host.docker.internal reaches the backend's docker-compose (LocalStack :4566, Redis :6379)
# from inside the kind node on Docker Desktop. Queue and table names match its local/init.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://host.docker.internal:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
FAULTS_QUEUE_URL=http://host.docker.internal:4566/000000000000/faults
SESSIONS_TABLE=Sessions
MOCK_NAMESPACE=mock
REDIS_URL=redis://host.docker.internal:6379
